# =============================================================================
# Tandem Environment Configuration Template
# Copy this file to .env and fill in your values. Never commit .env.
# =============================================================================

# Neon (recommended): paste the connection string from the Neon console
# (Dashboard → Connect). Either the pooled or direct URL works.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Alternative: a local PostgreSQL server. Used only when DATABASE_URL is empty.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=tandem_db
# DB_USER=postgres
# DB_PASS=
# DB_SSLMODE=prefer
